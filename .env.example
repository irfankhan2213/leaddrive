# Public browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these in client components.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=false
SERPAPI_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_TASK_ID=
PAGESPEED_API_KEY=

# v0 AI Engine (the only demo provider)
V0_API_KEY=
# Optional extra keys for automatic failover (comma or newline separated)
V0_BACKUP_API_KEYS=
V0_MODEL=v0-mini
V0_MAX_PROMPT_CHARS=3000

# Email Outreach Engine (Resend)
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=

# SMS Outreach Engine (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

APP_BASE_URL=http://localhost:3000

# HMAC secret for signed one-click unsubscribe links (openssl rand -hex 32).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
UNSUBSCRIBE_SECRET=

# When set, GET /api/health returns full diagnostics only with this token
# in the x-health-token header; otherwise it returns an opaque status.
HEALTH_CHECK_TOKEN=

# Google Cloud Platform & Vertex AI
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_CLIENT_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_ENABLED=true
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_SEARCH_GROUNDING=true
BIGQUERY_ENABLED=true
BIGQUERY_DATASET=leaddrive_analytics
